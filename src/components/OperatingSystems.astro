---
import { operatingSystems, operatingSystemsUi, type Lang } from '../data/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = operatingSystemsUi[lang];
---

<section class="pitch section transfers" id="transfers" aria-labelledby="transfers-title" data-os-presentation>
  <div class="wrap">
    <div class="transfer-heading">
      <div class="sec-head">
        <h2 class="t-display" id="transfers-title">{t.title}</h2>
        <p class="sec-sub t-body">{t.intro}</p>
      </div>
      <div class="transfer-controls" hidden>
        <button type="button" class="transfer-arrow" data-direction="-1" aria-label={t.previous} aria-controls="os-presentation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m14 5-7 7 7 7M7 12h14" /></svg>
        </button>
        <button type="button" class="transfer-arrow" data-direction="1" aria-label={t.next} aria-controls="os-presentation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m10 5 7 7-7 7M3 12h14" /></svg>
        </button>
      </div>
    </div>

    <p class="transfer-hint t-label" id="os-hint">{t.hint}</p>
    <p class="visually-hidden" id="os-keyboard">{t.keyboard}</p>

    <div class="presentation-footer">
      <p class="presentation-count t-label" aria-hidden="true"><span data-current>01</span><span class="count-rule"></span>{String(operatingSystems.length).padStart(2, '0')}</p>
      <nav class="presentation-progress" aria-label={t.steps}>
        {operatingSystems.map((os, index) => (
          <button class="progress-stop" type="button" data-step={index} aria-label={`${t.step} ${index + 1}: ${os.name}`} aria-controls="os-presentation" aria-current={index === 0 ? 'step' : undefined}>
            <span aria-hidden="true"></span>
          </button>
        ))}
      </nav>
    </div>

    <div class="presentation" id="os-presentation" tabindex="0" role="region" aria-roledescription={lang === 'es' ? 'presentación' : 'presentation'} aria-label={t.title} aria-describedby="os-hint os-keyboard">
      <ol class="presentation-stops" aria-live="polite" aria-atomic="true">
        {operatingSystems.map((os, index) => {
          const c = os[lang];
          return (
            <li class="presentation-stop" aria-roledescription={lang === 'es' ? 'diapositiva' : 'slide'} aria-label={`${t.step} ${index + 1} ${t.of} ${operatingSystems.length}`}>
              <div class="presentation-logo">
                <img src={`/images/os/${os.logo}.svg`} alt="" width="240" height="240" decoding="async" />
                <span class="presentation-number t-label" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <div class="presentation-copy">
                <p class="presentation-date t-label">
                  {os.start ? <time datetime={os.start}>{c.since}</time> : <span>{c.since}</span>}
                  <span aria-hidden="true"> — </span>
                  {os.end ? <time datetime={os.end}>{c.until}</time> : <span>{c.until}</span>}
                </p>
                <h3 class="presentation-name">{os.name}</h3>
                <p class="presentation-context t-body">{c.context}</p>
                {!os.end && <p class="transfer-active t-label"><span aria-hidden="true"></span>{t.active}</p>}
              </div>
            </li>
          );
        })}
      </ol>
    </div>

  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-os-presentation]').forEach((section) => {
    const viewport = section.querySelector<HTMLElement>('.presentation')!;
    const slides = Array.from(section.querySelectorAll<HTMLElement>('.presentation-stop'));
    const controls = section.querySelector<HTMLElement>('.transfer-controls')!;
    const buttons = Array.from(controls.querySelectorAll<HTMLButtonElement>('button'));
    const progressStops = Array.from(section.querySelectorAll<HTMLButtonElement>('.progress-stop'));
    const counter = section.querySelector<HTMLElement>('[data-current]')!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let pointerStart: { x: number; y: number; id: number } | undefined;

    const select = (index: number) => {
      const next = Math.max(0, Math.min(slides.length - 1, index));
      if (next === current) return;

      const previousSlide = slides[current];
      const nextSlide = slides[next];
      const direction = next > current ? 1 : -1;
      previousSlide.style.setProperty('--travel-direction', String(direction));
      previousSlide.classList.remove('is-current', 'is-entering');
      previousSlide.classList.add('is-leaving');
      previousSlide.setAttribute('aria-hidden', 'true');
      previousSlide.inert = true;

      nextSlide.classList.remove('is-leaving', 'is-current', 'is-entering');
      nextSlide.style.setProperty('--travel-direction', String(direction));
      nextSlide.inert = false;
      nextSlide.removeAttribute('aria-hidden');

      if (!reducedMotion.matches) {
        nextSlide.classList.add('is-entering');
        void nextSlide.offsetWidth;
      }
      nextSlide.classList.add('is-current');

      current = next;
      counter.textContent = String(current + 1).padStart(2, '0');
      progressStops.forEach((stop, stopIndex) => {
        if (stopIndex === current) stop.setAttribute('aria-current', 'step');
        else stop.removeAttribute('aria-current');
      });
      buttons[0].disabled = current === 0;
      buttons[1].disabled = current === slides.length - 1;
    };

    slides.forEach((slide, index) => {
      if (index === 0) slide.classList.add('is-current');
      else {
        slide.setAttribute('aria-hidden', 'true');
        slide.inert = true;
      }
      slide.addEventListener('animationend', (event) => {
        if (event.target === slide && slide.classList.contains('is-leaving')) {
          slide.classList.remove('is-leaving');
          slide.classList.remove('is-entering');
        }
      });
    });

    viewport.classList.add('is-enhanced');
    controls.hidden = false;
    buttons[0].disabled = true;
    buttons[1].disabled = false;
    buttons.forEach((button) => button.addEventListener('click', () => select(current + Number(button.dataset.direction))));
    progressStops.forEach((stop) => stop.addEventListener('click', () => select(Number(stop.dataset.step))));

    viewport.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        select(current + (event.key === 'ArrowRight' ? 1 : -1));
      } else {
        select(event.key === 'Home' ? 0 : slides.length - 1);
      }
    });

    viewport.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 || event.target instanceof Element && event.target.closest('button')) return;
      pointerStart = { x: event.clientX, y: event.clientY, id: event.pointerId };
      viewport.setPointerCapture(event.pointerId);
    });
    viewport.addEventListener('pointerup', (event) => {
      if (!pointerStart || pointerStart.id !== event.pointerId) return;
      const dx = event.clientX - pointerStart.x;
      const dy = event.clientY - pointerStart.y;
      pointerStart = undefined;
      if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy) * 1.25) return;
      select(current + (dx > 0 ? 1 : -1));
    });
    viewport.addEventListener('pointercancel', () => { pointerStart = undefined; });
  });
</script>

<style>
  .transfers { padding-top: var(--space-loose); }
  .transfer-heading .t-display { font-size: clamp(var(--fs-display), 5vw, 4.5rem); }
  .transfer-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-base); margin-bottom: var(--space-base); }
  .transfer-heading .sec-head { margin: 0; max-width: 900px; }
  .transfer-controls { display: flex; flex: none; gap: var(--space-tight); }
  .transfer-controls[hidden] { display: none; }
  .transfer-arrow { display: grid; place-items: center; width: 48px; height: 48px; padding: 0; border: 1px solid var(--chalk-dim); background: transparent; color: var(--chalk); cursor: pointer; transition: background 140ms var(--ease), color 140ms var(--ease); }
  .transfer-arrow:hover:not(:disabled) { background: var(--chalk); color: var(--pitch); }
  .transfer-arrow:active:not(:disabled) { background: var(--chalk-dim); }
  .transfer-arrow:disabled { opacity: 0.4; cursor: default; }
  .transfer-hint { color: var(--chalk-dim); line-height: 1.5; margin-bottom: var(--space-base); }

  .presentation { position: relative; min-height: clamp(360px, 41vw, 530px); overflow: clip; border-block: 1px solid rgba(244, 246, 241, 0.3); touch-action: pan-y; }
  .presentation:focus-visible { outline-offset: 5px; }
  .presentation-stops { display: grid; list-style: none; min-height: inherit; }
  .presentation-stop { position: relative; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(24px, 6vw, 88px); grid-area: 1 / 1; min-height: inherit; padding: clamp(32px, 6vw, 80px); }
  .presentation-logo { position: relative; display: grid; justify-items: center; align-items: center; min-height: 240px; }
  .presentation-logo img { width: clamp(150px, 22vw, 260px); height: clamp(150px, 22vw, 260px); object-fit: contain; }
  .presentation-number { position: absolute; left: 0; bottom: 0; color: var(--chalk-dim); font-variant-numeric: tabular-nums; }
  .presentation-date { color: var(--chalk-dim); line-height: 1.5; max-width: 46ch; }
  .presentation-name { margin-top: var(--space-base); font-size: clamp(2.25rem, 8vw, 4.75rem); font-weight: 900; font-stretch: 110%; line-height: 0.88; letter-spacing: -0.04em; text-transform: uppercase; text-wrap: balance; }
  .presentation-context { margin-top: var(--space-base); color: var(--chalk-dim); }
  .transfer-active { display: flex; align-items: center; gap: var(--space-tight); color: var(--board-amber); margin-top: var(--space-base); }
  .transfer-active span { width: 8px; height: 8px; background: currentColor; }

  .presentation.is-enhanced .presentation-stop { visibility: hidden; opacity: 0; pointer-events: none; transform: translateX(3vw); }
  .presentation.is-enhanced .presentation-stop.is-current { visibility: visible; opacity: 1; pointer-events: auto; transform: translateX(0); }
  .presentation.is-enhanced .presentation-stop.is-leaving { visibility: visible; opacity: 0; transform: translateX(calc(var(--travel-direction, 1) * -3vw)); transition: opacity 240ms ease-in, transform 320ms var(--ease), visibility 0s 320ms; }
  @media (prefers-reduced-motion: no-preference) {
    .presentation.is-enhanced .presentation-stop { transition: opacity 240ms ease-in, transform 320ms var(--ease), visibility 0s 320ms; }
    .presentation.is-enhanced .presentation-stop.is-entering .presentation-logo { animation: crest-arrive 620ms var(--ease) both; }
    .presentation.is-enhanced .presentation-stop.is-entering .presentation-copy { animation: copy-arrive 480ms var(--ease) 70ms both; }
  }
  @keyframes crest-arrive { from { opacity: 0; transform: translateX(calc(var(--travel-direction, 1) * 48px)) scale(0.84); } to { opacity: 1; transform: translateX(0) scale(1); } }
  @keyframes copy-arrive { from { opacity: 0; transform: translateX(calc(var(--travel-direction, 1) * 26px)); } to { opacity: 1; transform: translateX(0); } }

  .presentation-footer { display: flex; align-items: center; justify-content: space-between; gap: var(--space-base); margin-bottom: var(--space-snug); }
  .presentation-count { display: flex; align-items: center; gap: 12px; color: var(--chalk-dim); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .presentation-count [data-current] { color: var(--chalk); }
  .count-rule { width: 36px; height: 1px; background: rgba(244, 246, 241, 0.35); }
  .presentation-progress { display: flex; align-items: center; width: min(62%, 440px); }
  .progress-stop { position: relative; display: grid; align-items: center; justify-items: start; flex: 1; min-width: 44px; height: 44px; border: 0; background: transparent; cursor: pointer; }
  .progress-stop::before { position: absolute; right: 0; left: 0; height: 2px; background: rgba(244, 246, 241, 0.35); content: ''; }
  .progress-stop span { position: relative; width: 10px; height: 10px; border: 2px solid var(--chalk-dim); background: var(--pitch); transition: background 180ms var(--ease), border-color 180ms var(--ease), transform 180ms var(--ease); }
  .progress-stop:hover span { transform: scale(1.25); }
  .progress-stop[aria-current='step'] span { border-color: var(--chalk); background: var(--chalk); }

  @media (max-width: 599px) {
    .transfer-heading { align-items: start; flex-direction: column; gap: var(--space-base); }
    .presentation { min-height: 400px; }
    .presentation-stop { grid-template-columns: 1fr; align-content: center; gap: var(--space-base); padding: var(--space-base); }
    .presentation-logo { min-height: 140px; }
    .presentation-logo img { width: 136px; height: 136px; }
    .presentation-number { left: 0; bottom: 0; }
    .presentation-name { margin-top: var(--space-snug); font-size: clamp(var(--fs-display), 13vw, 4rem); }
    .presentation-context { margin-top: var(--space-snug); }
    .presentation-progress { width: min(70%, 300px); }
    .presentation-count { gap: 8px; }
    .count-rule { width: 18px; }
  }
  @media (max-height: 760px) and (min-width: 600px) {
    .transfers { padding-top: var(--space-snug); }
    .presentation { min-height: 360px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .presentation.is-enhanced .presentation-stop.is-leaving { transition-duration: 0s; }
  }
</style>
